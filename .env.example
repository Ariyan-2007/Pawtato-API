# --- App ---
PORT=5000
NODE_ENV=development
API_PREFIX=api
# Public base URL the app is reachable at (used in generated QR codes, log messages).
APP_URL=http://localhost:5000
# Comma-separated list of allowed CORS origins, e.g. https://app.pawtato.com,https://admin.pawtato.com
CORS_ORIGINS=

# --- Database ---
MONGO_URI=mongodb://admin:password@localhost:27017/pawtato?authSource=admin

# --- Auth ---
JWT_SECRET=
JWT_EXPIRES=1d
REFRESH_SECRET=
REFRESH_EXPIRES=7d

# --- Mail (optional; vaccination reminders and other emails are skipped/fail silently without it) ---
MAIL_HOST=
MAIL_PORT=587
MAIL_USER=
MAIL_PASSWORD=
MAIL_FROM=Pawtato <no-reply@pawtato.app>
