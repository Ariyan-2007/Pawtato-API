<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light" />
    <title>Pawtato</title>
    <style>
      @media only screen and (max-width: 600px) {
        .pawtato-container {
          width: 100% !important;
        }
        .pawtato-card {
          border-radius: 0 !important;
          padding: 28px 24px !important;
        }
      }
    </style>
  </head>
  <body
    style="margin: 0; padding: 0; background-color: #f4ede1; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;"
  >
    <table
      role="presentation"
      width="100%"
      cellpadding="0"
      cellspacing="0"
      style="background-color: #f4ede1;"
    >
      <tr>
        <td align="center" style="padding: 32px 16px;">
          <table
            role="presentation"
            class="pawtato-container"
            width="560"
            cellpadding="0"
            cellspacing="0"
            style="width: 560px; max-width: 560px;"
          >
            <tr>
              <td
                class="pawtato-card"
                style="background-color: #fbf7ef; border-radius: 20px; padding: 40px;"
              >
                <div
                  style="font-family: Georgia, 'Times New Roman', serif; font-weight: bold; font-size: 20px; color: #241f18;"
                >
                  Pawtato
                </div>

                <div
                  style="height: 1px; line-height: 1px; font-size: 1px; background-color: #7c8557; opacity: 0.55; margin: 16px 0 28px 0;"
                >
                  &nbsp;
                </div>

                {{{body}}}
              </td>
            </tr>
          </table>
        </td>
      </tr>
    </table>
  </body>
</html>
